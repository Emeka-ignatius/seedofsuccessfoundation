{
  "name": "seedofsuccessfoundation",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 2017",
    "dev:live": "node scripts/run-with-env.mjs SITE_MODE=live -- next dev -p 2017",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:strict": "vitest run tests/strict",
    "test:db": "node scripts/run-with-env.mjs RUN_DB_TESTS=1 -- vitest run tests/strict/rate-limit.test.ts",
    "launch:check": "node scripts/run-with-env.mjs LAUNCH_CHECK=1 -- vitest run tests/launch",
    "media:holding": "node scripts/media/holding.mjs",
    "e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "codeowners:gen": "node scripts/protected/gen-codeowners.mjs",
    "codeowners:check": "node scripts/protected/gen-codeowners.mjs --check",
    "prepare": "git config core.hooksPath .githooks",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:sql": "prisma migrate diff --from-empty --to-schema prisma/schema.prisma --script"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "prisma": "7.10.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@11.2.2"
}
