# Copy to .env.local (never commit real values). Production secrets live in Vercel, not in files.

# What the production domain serves. Only the exact value "live" exposes the full site.
# Anything else, including unset, serves the holding page.
SITE_MODE=holding

# Neon Postgres (London). Migrations use the DIRECT url; Vercel runtime should use the POOLED url (host has "-pooler").
# DATABASE_URL=

# Keys the HMAC that scrambles client addresses for rate limiting. 32+ random characters.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# RATE_LIMIT_SECRET=

# Cloudflare Turnstile. Cloudflare publishes always-pass TEST keys for development:
#   site:   1x00000000000000000000AA
#   secret: 1x0000000000000000000000000000000AA
# Production keys come from the client's Cloudflare account and are set in Vercel only.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
